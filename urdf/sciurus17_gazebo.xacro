<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="material_gazebo_black">
    <visual>
      <material>
        <ambient>0.2 0.2 0.2 1</ambient>
        <diffuse>0.0 0.0 0.0 1</diffuse>
      </material>
    </visual>
  </xacro:macro>

  <xacro:macro name="material_gazebo_white">
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1</ambient>
        <diffuse>0.95 0.95 0.95 1</diffuse>
      </material>
    </visual>
  </xacro:macro>

  <xacro:macro name="material_gazebo_red">
    <visual>
      <material>
        <ambient>1.0 0.3 0.3 1</ambient>
        <diffuse>1.0 0.0 0.0 1</diffuse>
      </material>
    </visual>
  </xacro:macro>

  <xacro:macro name="gazebo_robot_settings"
               params="use_gazebo_head_camera:=false
               use_gazebo_chest_camera:=false
               gz_control_config_package:=''
               gz_control_config_file_path:=''">
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find ${gz_control_config_package})/${gz_control_config_file_path}</parameters>
      </plugin>
    </gazebo>

    <gazebo reference="base_link">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="body_link">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="neck_yaw_link">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="neck_pitch_link">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo>
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </gazebo>

    <xacro:if value="${use_gazebo_head_camera}">
      <gazebo reference="head_camera_color_frame">
        <sensor name="sim_realsense_d415" type="rgbd_camera">
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <topic>head_camera</topic>
          <frame_id>head_camera_color_frame</frame_id>
          <camera name="realsense_d415">
            <xacro:property name="head_camera_width" value="640"/>
            <xacro:property name="head_camera_height" value="360"/>
            <xacro:property name="head_camera_hfov" value="${radians(69.4)}"/>
            <xacro:property name="head_camera_focal_length" value="${head_camera_width / (2 * tan(head_camera_hfov / 2))}"/>
            <horizontal_fov>${head_camera_hfov}</horizontal_fov>
            <image>
              <width>${head_camera_width}</width>
              <height>${head_camera_height}</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
            <depth_camera>
              <clip>
                <near>0.1</near>
                <far>3.0</far>
              </clip>
            </depth_camera>
            <optical_frame_id>head_camera_color_optical_frame</optical_frame_id>
            <lens>
              <intrinsics>
                <fx>${head_camera_focal_length}</fx>
                <fy>${head_camera_focal_length}</fy>
                <cx>${(head_camera_width + 1) / 2}</cx>
                <cy>${(head_camera_height + 1) / 2}</cy>
                <s>1.0</s>
              </intrinsics>
              <projection>
                <p_fx>${head_camera_focal_length}</p_fx>
                <p_fy>${head_camera_focal_length}</p_fy>
                <p_cx>${(head_camera_width + 1) / 2}</p_cx>
                <p_cy>${(head_camera_height + 1) / 2}</p_cy>
                <tx>0</tx>
                <ty>0</ty>
              </projection>
            </lens>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

    <xacro:if value="${use_gazebo_chest_camera}">
      <gazebo reference="chest_camera_link">
        <sensor name="chest_camera" type="camera">
          <pose relative_to="chest_camera_link">0 0 0 ${radians(90)} ${radians(-90)} 0</pose>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <topic>chest_camera/image_raw</topic>
          <frame_id>chest_camera_link</frame_id>
          <camera name="chest_camera">
            <xacro:property name="chest_camera_width" value="640"/>
            <xacro:property name="chest_camera_height" value="360"/>
            <xacro:property name="chest_camera_hfov" value="${radians(120)}"/>
            <xacro:property name="chest_camera_focal_length" value="${chest_camera_width / (2 * tan(chest_camera_hfov / 2))}"/>
            <horizontal_fov>${chest_camera_hfov}</horizontal_fov>
            <image>
              <width>${chest_camera_width}</width>
              <height>${chest_camera_height}</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
            <lens>
              <intrinsics>
                <fx>${chest_camera_focal_length}</fx>
                <fy>${chest_camera_focal_length}</fy>
                <cx>${(chest_camera_width + 1) / 2}</cx>
                <cy>${(chest_camera_height + 1) / 2}</cy>
                <s>1.0</s>
              </intrinsics>
              <projection>
                <p_fx>${chest_camera_focal_length}</p_fx>
                <p_fy>${chest_camera_focal_length}</p_fy>
                <p_cx>${(chest_camera_width + 1) / 2}</p_cx>
                <p_cy>${(chest_camera_height + 1) / 2}</p_cy>
                <tx>0</tx>
                <ty>0</ty>
              </projection>
            </lens>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

    <gazebo reference="r_link1">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="r_link2">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="r_link3">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="r_link4">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="r_link5">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="r_link6">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="r_link7">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="r_gripperA_link">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="r_gripperB_link">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="l_link1">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="l_link2">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="l_link3">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="l_link4">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="l_link5">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="l_link6">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="l_link7">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="l_gripperA_link">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="l_gripperB_link">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <xacro:material_gazebo_red/>
    </gazebo>

  </xacro:macro>
</robot>
